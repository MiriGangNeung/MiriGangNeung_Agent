# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Secrets and local runtime data
.env
*.local

# Temporary image storage (사용자 사진이 들어가므로 절대 커밋하지 않는다)
tmp/
/tmp-images/
assets/backgrounds/*.jpg
assets/backgrounds/*.jpeg
assets/backgrounds/*.png
!assets/backgrounds/.gitkeep

# Editors / OS
.idea/
.vscode/
.DS_Store

# 합성 테스트 산출물 — 재생성 가능하고 용량이 커서 추적하지 않는다.
# 평가 근거는 Notion 리포트와 게시된 아티팩트에 남긴다.
test_results/

# 테스트에 쓴 인물 사진 — 사람이 찍힌 사진이라 공유 저장소에 올리지 않는다.
# 이름을 하나씩 나열하면 새로 추가하는 사진이 매번 새므로 리포 루트의 이미지를
# 통째로 무시한다. 서비스가 쓰는 이미지는 assets/ 와 models/ 아래에 있어 영향 없다.
/*.jpg
/*.jpeg
/*.png
/*.webp

# 배경 후보 페이지 — 썸네일을 base64로 내장해 1.6MB다. 아티팩트로 게시돼 있고
# scripts 로 언제든 다시 만들 수 있어 추적하지 않는다.
강릉_배경_후보.html
