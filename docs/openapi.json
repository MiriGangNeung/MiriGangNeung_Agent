        "title": "HealthResponse",
        "type": "object"
      },
      "JobStatus": {
        "enum": [
          "QUEUED",
          "ANALYZING",
          "COMPOSITING",
          "QUALITY_CHECK",
          "DONE",
          "FAILED"
        ],
        "title": "JobStatus",
        "type": "string"
      },
      "MetaResponse": {
        "properties": {
          "errorCodes": {
            "items": {
              "$ref": "#/components/schemas/ErrorCodeSpec"
            },
