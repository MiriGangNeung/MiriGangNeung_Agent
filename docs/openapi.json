          "imageReference": {
            "title": "Imagereference",
            "type": "string"
          },
          "width": {
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "imageReference",
          "width",
          "height",
          "aspectRatio"
        ],
        "title": "GenerationResult",
        "type": "object"
      },
