            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VariationMode": {
        "description": "요구사항 E4: '허용된 횟수 내에서 구도나 분위기를 변경해 다시 생성'.\n\nUI 설계서 재생성 버튼의 두 옵션 중 '다른 배경 선택'은 onePickPlaceId/background를\n바꿔 다시 요청하면 되므로 이미 지원된다. 이 값은 나머지 옵션인\n'구도, 스타일만 살짝 조정'에 대응한다.",
        "enum": [
          "same",
          "new_pose",
          "new_mood"
        ],
        "title": "VariationMode",
        "type": "string"
      }
    }
