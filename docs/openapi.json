{
  "components": {
    "schemas": {
      "AspectRatio": {
        "description": "요구사항 E4: SNS에 적합한 비율.",
        "enum": [
          "1:1",
          "4:5",
          "9:16"
        ],
        "title": "AspectRatio",
        "type": "string"
      },
      "Body_create_generation_v1_generations_post": {
        "properties": {
          "aspectRatio": {
            "$ref": "#/components/schemas/AspectRatio",
            "default": "4:5"
          },
          "background": {
            "anyOf": [
              {
                "contentMediaType": "application/octet-stream",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "배경 이미지. 백엔드가 Place.thumbnailUrl/PlaceImage.imageUrl(한국관광공사 이미지)에서 가져와 전달해야 한다. mock provider가 아니면 사실상 필수.",
            "title": "Background"
          },
          "backgroundImageUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "사용자가 프론트에서 고른 배경 사진의 원본 URL(PlaceImage.imageUrl). place_insights.json에서 그 사진 정확히 하나의 사전 분석(카메라/인물 배치 등)을 찾는 데 쓴다. 없으면 해당 장소의 대표 이미지 분석으로 폴백한다.",
            "title": "Backgroundimageurl"
          },
          "idempotencyKey": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotencykey"
          },
          "onePickPlaceId": {
            "description": "원픽 관광지 ID (백엔드 Place.id UUID)",
            "title": "Onepickplaceid",
            "type": "string"
          },
          "photo": {
            "contentMediaType": "application/octet-stream",
            "description": "사용자 사진 (JPG/PNG/WEBP, 최대 10MB)",
            "title": "Photo",
            "type": "string"
          },
          "placeDescription": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Place.description (프롬프트 힌트)",
            "title": "Placedescription"
          },
          "placeName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Place.name (프롬프트 힌트)",
            "title": "Placename"
          },
          "placeRegion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Place.region (프롬프트 힌트)",
            "title": "Placeregion"
          },
          "sessionId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sessionid"
          },
          "variationMode": {
            "$ref": "#/components/schemas/VariationMode",
            "default": "same",
            "description": "요구사항 E4 재생성 옵션 중 '구도, 스타일만 살짝 조정'. same(기본, 동일 요청은 재사용) | new_pose(다른 구도/포즈) | new_mood(다른 분위기/톤). '다른 배경 선택' 옵션은 onePickPlaceId/background를 바꿔 재요청하면 된다."
          }
        },
        "required": [
          "photo",
          "onePickPlaceId"
        ],
        "title": "Body_create_generation_v1_generations_post",
        "type": "object"
      },
      "ErrorCodeSpec": {
        "description": "`error.code` 하나의 계약. 백엔드가 재시도 여부를 자체 판단하지 않게 한다.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "httpStatus": {
            "title": "Httpstatus",
            "type": "integer"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "httpStatus",
          "retryable",
          "message"
        ],
        "title": "ErrorCodeSpec",
        "type": "object"
      },
      "ErrorPayload": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "title": "ErrorPayload",
        "type": "object"
      },
      "GenerationJobResponse": {
        "properties": {
          "coarseStatus": {
            "title": "Coarsestatus",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorPayload"
              },
              {
                "type": "null"
              }
            ]
          },
          "metadata": {
            "$ref": "#/components/schemas/GenerationMetadata"
          },
          "progress": {
            "title": "Progress",
            "type": "integer"
          },
          "providerJobId": {
            "title": "Providerjobid",
            "type": "string"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GenerationResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "safety": {
            "$ref": "#/components/schemas/SafetyReport"
          },
          "stage": {
            "title": "Stage",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          }
        },
        "required": [
          "providerJobId",
          "status",
          "coarseStatus",
          "stage",
          "progress",
          "metadata"
        ],
        "title": "GenerationJobResponse",
        "type": "object"
      },
      "GenerationMetadata": {
        "description": "요구사항 E9: 생성 이력에 남겨야 하는 값들.",
        "properties": {
          "attempts": {
            "default": 0,
            "title": "Attempts",
            "type": "integer"
          },
          "completedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completedat"
          },
          "createdAt": {
            "title": "Createdat",
            "type": "string"
          },
          "durationMs": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Durationms"
          },
          "estimatedCostUsd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimatedcostusd"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "onePickPlaceId": {
            "title": "Onepickplaceid",
            "type": "string"
          },
          "promptVersion": {
            "title": "Promptversion",
            "type": "string"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "styleTags": {
            "items": {
              "$ref": "#/components/schemas/StyleTag"
            },
            "title": "Styletags",
            "type": "array"
          }
        },
        "required": [
          "provider",
          "model",
          "promptVersion",
          "onePickPlaceId",
          "createdAt"
        ],
        "title": "GenerationMetadata",
        "type": "object"
      },
      "GenerationResult": {
        "properties": {
          "aspectRatio": {
            "$ref": "#/components/schemas/AspectRatio"
