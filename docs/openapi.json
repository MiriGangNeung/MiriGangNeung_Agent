          "provider",
          "imageModel",
          "visionModel",
          "promptVersion",
          "supportedAspectRatios",
          "maxUploadBytes",
          "resultTtlSeconds",
          "errorCodes",
          "safetyReasonCodes"
        ],
        "title": "MetaResponse",
        "type": "object"
      },
      "SafetyReasonSpec": {
        "description": "`safety.reasonCode` 하나와 사용자에게 보일 문구.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "SafetyReasonSpec",
        "type": "object"
      },
      "SafetyReport": {
        "properties": {
          "reasonCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reasoncode"
          },
          "status": {
            "$ref": "#/components/schemas/SafetyStatus",
            "default": "UNKNOWN"
          }
        },
        "title": "SafetyReport",
        "type": "object"
      },
      "SafetyStatus": {
        "enum": [
          "PASSED",
          "REJECTED",
          "UNKNOWN"
        ],
        "title": "SafetyStatus",
        "type": "string"
      },
      "StyleTag": {
        "description": "요구사항 B6: 태그 + 신뢰도 점수.",
        "properties": {
          "category": {
            "title": "Category",
            "type": "string"
          },
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "value": {
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "category",
          "value",
          "confidence"
        ],
        "title": "StyleTag",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
