# 이 파일을 .env로 복사한 뒤 실제 값만 채운다. .env는 절대 커밋하지 않는다.

# ── 서비스 ──────────────────────────────────────────────
# 백엔드가 이 서비스를 호출할 때 사용하는 키. 백엔드 .env의 AI_API_KEY와 같은 값이어야 한다.
# 비워 두면 인증 검사를 건너뛴다 (로컬 개발 전용).
AI_API_KEY=
PORT=8100
LOG_LEVEL=INFO

# ── Provider ────────────────────────────────────────────
AI_PROVIDER=mock                              # gemini | mock
GOOGLE_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image     # Nano Banana 2
GEMINI_VISION_MODEL=gemini-3.1-flash-lite     # 스타일 분석 / 품질 검사용
PROVIDER_TIMEOUT_SECONDS=120
PROVIDER_MAX_RETRIES=2

# ── Job store ───────────────────────────────────────────
# REDIS_HOST를 비우면 인메모리 JobStore로 폴백한다.
REDIS_HOST=
REDIS_PORT=6379
JOB_TTL_SECONDS=86400

# ── 이미지 / 개인정보 ───────────────────────────────────
IMAGE_TEMP_DIR=/tmp/mirigangneung-ai
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
RESULT_TTL_SECONDS=86400

# ── 비용 제어 ───────────────────────────────────────────
DAILY_GENERATION_BUDGET=500
RATE_LIMIT_PER_SESSION_PER_HOUR=10

# ── 얼굴 검출 ───────────────────────────────────────────
# 비워두면 OpenCV 번들 Haar cascade를 쓴다 (추가 파일 없이 동작하지만 정확도가 낮다).
# 리포에 YuNet ONNX 모델을 함께 커밋해 뒀으므로(models/), 기본값을 그쪽으로 맞춰 둔다.
# 운영에서 굳이 Haar로 되돌리고 싶으면 이 값을 비운다.
FACE_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
